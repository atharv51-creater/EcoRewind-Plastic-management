# Trained model artifacts. Relative paths are relative to this folder.
ECOREWIND_MODEL_PATH=../outputs/ecorewind_classifier.keras
ECOREWIND_LABELS_PATH=../outputs/labels.json
ECOREWIND_THRESHOLD=0.75

# Classes the machine pays for. Everything else is rejected.
ECOREWIND_ACCEPTED_CLASSES=plastic_bottle,aluminium_can,plastic_bag

# Paise per gram. Money is always integer paise. The web terminal reads these
# from GET /rates, so change them here only.
ECOREWIND_RATES=plastic_bottle:2,aluminium_can:4,plastic_bag:1

# Weight sanity rules
ECOREWIND_MIN_WEIGHT_G=100
ECOREWIND_MAX_WEIGHT_G=500
ECOREWIND_BONUS_THRESHOLD_G=400
ECOREWIND_BONUS_PCT=10

# Wallet database and HTTP
ECOREWIND_DB_PATH=./data/scanner.db
ECOREWIND_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
ECOREWIND_MAX_IMAGE_BYTES=8000000

# Optional shared keys. Leave blank for local demo only. If you set the API key,
# export the same ECOREWIND_API_KEY before running serve.py so its /api proxy
# can add it; the key never reaches the browser.
ECOREWIND_API_KEY=
ECOREWIND_ADMIN_KEY=

# keras | fake | unavailable. NEVER use fake in production.
ECOREWIND_CLASSIFIER=keras
# ECOREWIND_FAKE_LABEL=plastic_bottle
# ECOREWIND_FAKE_CONFIDENCE=0.99
